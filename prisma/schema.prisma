// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

// Define la base de datos relacional de Victorino Calzados: productos, variantes, pedidos e ítems vendidos.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Agrega un código comercial único para identificar productos de forma estable en importaciones e integraciones.
model Product {
  id          Int              @id @default(autoincrement())
  code        String?          @unique
  name        String
  description String
  category    String
  price       Int
  image       String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  orderItems  OrderItem[]
}

// Almacena las URLs y metadatos de la galería sin guardar archivos binarios en PostgreSQL.
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String
  position  Int      @default(0)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  color     String
  size      Int
  stock     Int      @default(0)
  sku       String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, color, size])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              Int          @id @default(autoincrement())
  orderNumber     String       @unique
  firstName       String
  lastName        String
  email           String
  phone           String
  shippingMethod  String
  paymentMethod   String
  address         String?
  city            String?
  postalCode      String?
  subtotal        Int
  shippingCost    Int
  total           Int
  status OrderStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id          Int            @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   Int
  productName String
  color       String
  size        Int
  unitPrice   Int
  quantity    Int

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}
